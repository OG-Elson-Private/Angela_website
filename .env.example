# =============================================================================
# Chef Angela Website — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real values to git.
# =============================================================================

# --- Database (Prisma / Neon PostgreSQL) ---
# Connection string for your PostgreSQL database
# Get this from your Neon dashboard: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth (Authentication) ---
# Random secret for JWT encryption — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# Base URL of the site (used by NextAuth for callbacks)
NEXTAUTH_URL="http://localhost:3000"

# --- Admin Credentials ---
# Email and password for the admin backoffice (/admin/login)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-secure-password"

# --- Email Notifications (Resend) ---
# API key from https://resend.com/api-keys (free tier: 100 emails/day)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Email to receive new testimonial notifications (defaults to ADMIN_EMAIL)
NOTIFICATION_EMAIL="liyayiangela20@gmail.com"

# --- Rate Limiting (Upstash Redis) ---
# Get these from https://console.upstash.com (free tier available)
# If not set, falls back to in-memory rate limiting (dev mode only)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# --- Application ---
# Public base URL (used for server-side API calls during SSR/build)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
